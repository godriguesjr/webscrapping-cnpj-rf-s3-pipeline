# Copie para .env e preencha. O .env é ignorado pelo git.
#
# Conta:   aws sts get-caller-identity --query Account --output text
# Token:   está no link público da base CNPJ, publicado pela Receita Federal
#          (o mesmo trecho que aparece depois de /public.php/dav/files/).
#
# O bucket precisa existir na mesma região da instância.

AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1
CNPJ_BUCKET=cnpj-rf-123456789012
CNPJ_WEBDAV_TOKEN=cole_o_token_aqui
CNPJ_DESDE=2026-08

# Nomes lógicos usados pela Lambda e pelas tags (não são segredo)
WORKER_NAME=cnpj-rf-worker
PROJECT_TAG=cnpj-s3
